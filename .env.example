# ── Clinic Info ───────────────────────────────
CLINIC_NAME=RC5 Elite Motion
DOCTOR_NAME=Dr.Devang

# ── Pricing ───────────────────────────────────
PRICE_INR=99
CONSULTATION_PRICE_INR=249

# ── MongoDB ───────────────────────────────────
# Leave empty to use JSON file fallback (db.json)
MONGO_URI=mongodb://127.0.0.1:27017/rc5_clinic_db

# ── Razorpay ──────────────────────────────────
RZP_KEY_ID=rzp_test_xxxxxxxxxxxxx
RZP_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx

# ── WhatsApp Business Cloud API (Meta) ────────
WA_TOKEN=YOUR_WHATSAPP_ACCESS_TOKEN
WA_PHONE_NUMBER_ID=YOUR_PHONE_NUMBER_ID
WA_VERIFY_TOKEN=YOUR_CUSTOM_VERIFY_TOKEN
WA_CLINIC_NUMBER=919714351278
WHATSAPP_COMMUNITY_LINK=https://chat.whatsapp.com/your-invite-code

# ── JWT ───────────────────────────────────────
JWT_SECRET=your_strong_secret_key_here

# ── Server ────────────────────────────────────
PORT=3000

# ── CORS / Frontend URL (separate hosting) ────
# Comma-separated list of allowed frontend origins.
# Example: https://your-frontend.netlify.app,http://localhost:5500
# FRONTEND_URL=http://localhost:5500,http://127.0.0.1:5500
FRONTEND_URL= http://127.0.0.1:5502
# ── Optional: override /config.js when backend also serves frontend ──
# Leave blank to use same-origin (empty string). Set only if needed.
API_BASE_URL=
